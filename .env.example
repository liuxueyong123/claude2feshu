# ============================================================
# 飞书应用配置 — Claude Code 双向通信
# 复制为 .env:  cp .env.example .env
# ============================================================

# 必需：应用凭证（飞书开发者后台 → 应用 → 凭证与基础信息）
FEISHU_APP_ID=cli_aXXXXXXXXXXXX
FEISHU_APP_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# 可选：目标群聊 ID（不填则自动选第一个群）
# FEISHU_CHAT_ID=oc_xxxxxxxxxxxx

# 可选：轮询间隔（秒），默认 3
# FEISHU_POLL_INTERVAL=3
