# ============================================================
# claude2feishu 配置
# 复制为 .env:  cp .env.example .env
# ============================================================

# ── 必需：飞书应用凭证（飞书开发者后台 → 应用 → 凭证与基础信息）──
FEISHU_APP_ID=cli_aXXXXXXXXXXXX
FEISHU_APP_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# ── 可选：目标群聊 ID（不填则自动选第一个群）──
# FEISHU_CHAT_ID=oc_xxxxxxxxxxxx

# ── 可选：通知服务端口（默认 9876）──
# FEISHU_NOTIFYD_PORT=9876

# ── 可选：通知服务监听地址（默认 127.0.0.1，仅本地访问）──
# FEISHU_NOTIFYD_HOST=127.0.0.1

# ── 可选：消息轮询间隔，秒（默认 3）──
# FEISHU_POLL_INTERVAL=3

# ── 可选：日志级别 DEBUG | INFO | WARN | ERROR（默认 INFO）──
# FEISHU_LOG_LEVEL=INFO

# ── 可选：数据目录（默认 ~/.claude/feishu）──
# FEISHU_DATA_DIR=~/.claude/feishu
